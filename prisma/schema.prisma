generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id          String    @id @default(cuid())
  name        String
  school      String
  role        String    @default("תלמיד") // "תלמיד" | "הורה"
  grade       String // e.g. "ה"; "" for parents
  classNumber Int // e.g. 2; 0 for parents
  gender      String // "בן" | "בת" for students, "אבא" | "אמא" for parents
  createdAt   DateTime  @default(now())
  attempts    Attempt[]

  @@unique([name, school, role, grade, classNumber])
}

model Question {
  id           String   @id @default(cuid())
  text         String
  choices      String // JSON-encoded array of 4 strings
  correctIndex Int
  sourceHint   String // short note on where the fact comes from, shown after answering
  createdAt    DateTime @default(now())
}

model Attempt {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  correctCount Int
  totalCount   Int
  timeMs       Int
  isPractice   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([studentId])
}
